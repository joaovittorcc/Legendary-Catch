local byId: { [string]: Creature } = {}
for _, c in LIST do
	byId[c.id] = c
end

local Creatures = {}

Creatures.LIST = LIST
Creatures.PLANNED = PLANNED
Creatures.MODELS_FOLDER = "Creatures"

function Creatures.get(id: string): Creature?
	return byId[id]
end

function Creatures.ofRarity(rarity: string): { Creature }
	local out = {}
	for _, c in LIST do
		if c.rarity == rarity then
			table.insert(out, c)
		end
	end
	return out
end

-- Relative chance of `creature` inside its rarity.
function Creatures.dropWeight(creature: Creature): number
	local w = creature.dropWeight or DROP_WEIGHTS[creature.id] or 1
	return if w > 0 then w else 1
end

export type PoolEntry = { creature: Creature, weight: number }

-- Weighted pick from `pool` with `roll` in [0, 1). Returns the entry (nil for an empty pool) and
-- the pool's total weight, which the "1 in N" odds need.
function Creatures.pick(pool: { PoolEntry }, roll: number): (PoolEntry?, number)
	local total = 0
	for _, entry in pool do
		total += entry.weight
	end
	if #pool == 0 or total <= 0 then
		return nil, 0
	end
	local left = math.clamp(roll, 0, 1) * total
	for _, entry in pool do
		left -= entry.weight
		if left < 0 then
			return entry, total
		end
	end
	return pool[#pool], total
end

-- Coins for a catch of `weight` kg (0.75x at the minimum weight, 1.25x at the maximum).
function Creatures.valueFor(creature: Creature, weight: number): number
	local span = creature.weightMax - creature.weightMin
	local t = if span > 0 then math.clamp((weight - creature.weightMin) / span, 0, 1) else 0.5
	return math.floor(creature.baseValue * (0.75 + 0.5 * t) + 0.5)
end

return Creatures
